    "test:rocks": "node tests/rock_climb.mjs",
    "test:dock": "node tests/dock.mjs 0 && node tests/dock.mjs 1",
    "test:faults": "node tests/faults.mjs",
    "test:cycle": "node tests/autonomy.mjs cycle 12000"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "vite": "6.0.7"
  }
}