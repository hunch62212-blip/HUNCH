{
  "name": "llaso-p2-xport-sim",
  "version": "1.0.0",
  "description": "NASA HUNCH LLASO-P2-XPORT-2026 external cargo transport rover simulator",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173",
